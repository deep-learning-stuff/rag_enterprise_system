# Copia este fichero a `.env` si quieres cambiar credenciales o puertos.
# Docker Compose lee `.env` automáticamente. Sin `.env`, se usan estos mismos valores por defecto.

# Postgres
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DB_PORT=5432

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# Reranker (Fase 4b). Por defecto un modelo ligero multilingüe (~0.5 GB) que arranca
# en cualquier equipo, incluso con poca RAM. En una máquina con más memoria (o GPU)
# puedes usar el grande, más preciso, descomentando la línea de abajo:
#   RERANKER_MODEL=BAAI/bge-reranker-v2-m3   (necesita ~2.5 GB extra de RAM en Docker)
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Generación (Fase 5). LLM en la nube, configurable como el reranker: cambiar de
# proveedor o modelo es cambiar estas variables, no el código.
#   LLM_PROVIDER: "gemini" (default) o "openai".
#   LLM_MODEL: vacío = default del proveedor (gemini-2.5-flash / gpt-5-mini).
# Gemini tiene capa gratuita en Google AI Studio (https://aistudio.google.com/apikey),
# PERO su tier gratuito no permite uso comercial en la UE y Google puede usar los
# datos enviados: solo para desarrollo con datos de prueba. Para producción, usar
# OpenAI (o la capa de pago de Gemini).
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
